# CampusAI Environment Configuration

# Backend
PORT=8000
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Google Cloud & Vertex AI Gemini Integration
GOOGLE_CLOUD_PROJECT=campus-ai-intelligence
GOOGLE_CLOUD_REGION=us-central1
GEMINI_MODEL=gemini-1.5-pro
GEMINI_API_KEY=

# Database Configuration (SQLite default for local, PostgreSQL for Cloud SQL)
DATABASE_URL=sqlite:///./data/campus_ai.db

# Cloud Storage Bucket for Excel Workbook Uploads
GCS_WORKBOOK_BUCKET=campus-ai-workbooks-private
